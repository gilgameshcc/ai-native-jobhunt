{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "投递预算工具status的result字段",
  "type": "object",
  "required": [
    "confirmed",
    "pending",
    "sending",
    "reserved",
    "occupied",
    "remaining_budget",
    "target_remaining",
    "run_attempts",
    "day",
    "daily_target",
    "daily_cap",
    "risk_paused",
    "risk_note",
    "run_id",
    "owner",
    "lease_until",
    "config_hash"
  ],
  "properties": {
    "confirmed": {
      "type": "integer",
      "minimum": 0
    },
    "pending": {
      "type": "integer",
      "minimum": 0
    },
    "sending": {
      "type": "integer",
      "minimum": 0
    },
    "reserved": {
      "type": "integer",
      "minimum": 0
    },
    "occupied": {
      "type": "integer",
      "minimum": 0
    },
    "remaining_budget": {
      "type": "integer",
      "minimum": 0
    },
    "target_remaining": {
      "type": "integer",
      "minimum": 0
    },
    "run_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "day": {
      "type": "string",
      "format": "date"
    },
    "daily_target": {
      "type": "integer",
      "minimum": 1
    },
    "daily_cap": {
      "type": "integer",
      "minimum": 1
    },
    "risk_paused": {
      "type": "boolean"
    },
    "risk_note": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_until": {
      "type": [
        "string",
        "null"
      ]
    },
    "config_hash": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "_state_source": "私人工作区 runs/apply-state.sqlite3；status是查询结果，不是另一个可编辑状态源。",
  "_legacy_migration": "旧apply-lock.json的risk_paused/risk_note首次导入；旧in_progress须核实执行器已停止。旧计数不可直接作为成功数；手改旧锁不改变新库中的风险或计数。"
}
